# Database
DATABASE_URL="postgresql://user:password@localhost:5432/schoolfees?schema=public"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Netcash API Configuration
NETCASH_SERVICE_KEY=your-netcash-service-key
NETCASH_API_URL=https://paynow.netcash.co.za/site/paynow.aspx
NETCASH_PAYMENT_URL=https://paynow.netcash.co.za/site/paynow.aspx

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@schoolfees.com

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Payout Schedule (cron format)
PAYOUT_SCHEDULE="0 2 * * 1"

# Currency
DEFAULT_CURRENCY=ZAR

# App Configuration
APP_NAME="School Fee Management"
